{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/replay-and-discover/scripts/enforce_hook.py\" --require-live",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/replay-and-discover/scripts/digest_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
